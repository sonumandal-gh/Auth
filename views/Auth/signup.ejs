<%- include('../partials/head',{ pageTitle:"Signup", cssFile:"signup"}) %>

<body>

<%- include('../partials/nav') %>

<div class="container">

  <div class="signup-box">

    <h2>Create Account</h2>

    <% if(errorMessages && errorMessages.length > 0){ %>
      <div class="error-box">
        <p><%= errorMessages[0].msg %></p>
      </div>
    <% } %>

    <form action="/signup" method="POST">

      <!-- First + Last Name -->

      <div class="name-row">

        <div class="input-group">
          <label>First Name</label>
          <input 
            type="text" 
            name="firstName" 
            value="<%= oldInput.firstName || '' %>" 
            required>
        </div>
      
        <div class="input-group">
          <label>Last Name</label>
          <input 
            type="text" 
            name="lastName" 
            value="<%= oldInput.lastName || '' %>" 
            required>
        </div>
      
      </div>

      <!-- Email -->

      <div class="input-group">
        <label>Email</label>
        <input 
          type="email" 
          name="email" 
          value="<%= oldInput.email || '' %>" 
          required>
      </div>

      <!-- Password -->

      <div class="input-group">
        <label>Password</label>
        <input type="password" name="password" required>
      </div>

      <!-- Confirm Password -->

      <div class="input-group">
        <label>Confirm Password</label>
        <input type="password" name="confirmPassword" required>
      </div>

      <!-- User Type -->

      <div class="input-group">
        <label>User Type</label>

        <div class="radio-group">

          <label>
            <input 
              type="radio" 
              name="role" 
              value="student"
              <%= !oldInput.role || oldInput.role === "student" ? "checked" : "" %>
            >
            Student
          </label>

          <label>
            <input 
              type="radio" 
              name="role" 
              value="admin"
              <%= oldInput.role === "admin" ? "checked" : "" %>
            >
            Admin
          </label>

          <label>
            <input 
              type="radio" 
              name="role" 
              value="owner"
              <%= oldInput.role === "owner" ? "checked" : "" %>
            >
            Owner
          </label>

        </div>

      </div>

      <button type="submit">Sign Up</button>

    </form>

    <p class="login-link">
      Already have an account?
      <a href="/login">Login</a>
    </p>

  </div>

</div>

</body>